<div class="container-fluid">


    <!-- Content Row -->
    <div class="row">

        <div class="col-md-12 col-lg-8 col-xl-6 col-12">

            <!-- Basic Card Example -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary text-capitalize">kullanıcılar</h6>
                    <input name="kullanici-search-text" type="text" class="form-control bg-light border-0 small"
                        placeholder="Arama..." aria-label="Search" aria-describedby="basic-addon2">
                </div>
                <div class="card-body kullanici">
                    <p>
                        <button class="btn btn-danger text-uppercase m-2 " type="button" data-toggle="collapse"
                            data-target="#ekle" aria-expanded="false" aria-controls="collapseExample">
                            ekle
                        </button>
                        <% user_db.forEach(user_v=> { %>
                            <button class="btn btn-primary text-capitalize m-2" type="button" data-toggle="collapse"
                                data-target="#k<%= user_v._id _%>" aria-expanded="false"
                                aria-controls="collapseExample">
                                <%= user_v.name _%>&nbsp;<%= user_v.surname _%>
                            </button>
                            <% }); %>
                    </p>
                    <div class="collapse" id="ekle">
                        <div class="card card-body">


                            <div class="form-group">
                                <label class="text-capitalize" for="Input-name">isim</label>
                                <input type="text" class="form-control" id="Input-name" aria-describedby="nameHelp"
                                    placeholder="isim giriniz">
                                <small id="nameHelp" class="form-text text-muted text-capitalize">küçük harfle giriş
                                    yapınız</small>
                            </div>
                            <div class="form-group">
                                <label class="text-capitalize" for="Input-surname">soyad</label>
                                <input type="text" class="form-control" id="Input-surname"
                                    aria-describedby="surnameHelp" placeholder="soyad giriniz">
                                <small id="surnameHelp" class="form-text text-muted text-capitalize">küçük harfle giriş
                                    yapınız</small>
                            </div>
                            <div class="form-group">
                                <label class="text-capitalize" for="Input-email">e-posta</label>
                                <input type="text" class="form-control" id="Input-email" aria-describedby="emailHelp"
                                    placeholder="e-posta giriniz">
                                <small id="emailHelp" class="form-text text-muted text-capitalize">küçük harfle giriş
                                    yapınız</small>
                            </div>
                            <div class="form-group">
                                <label class="text-capitalize" for="Input-password">şifre</label>
                                <input type="text" class="form-control" id="Input-password"
                                    aria-describedby="passwordHelp" placeholder="şifre giriniz">
                                <small id="passwordHelp" class="form-text text-muted text-capitalize">küçük harfle giriş
                                    yapınız</small>
                            </div>
                            <div class="form-group">
                                <label class="text-capitalize" for="Input-tel_number">telefon numarası</label>
                                <input type="text" class="form-control" id="Input-tel_number"
                                    aria-describedby="tel_numberHelp" placeholder="telefon numarası giriniz">
                                <small id="tel_numberHelp" class="form-text text-muted text-capitalize"> giriş yapınız
                                </small>
                            </div>
                            <div class="form-group">
                                <label class="text-capitalize" for="Input-small_image">resim</label>
                                <form id="kullanici_photo" enctype="multipart/form-data">
                                    <label for="small_photo_kullanici" class="form-label text-capitalize">100x100
                                        fotoğraf yükleyiniz</label>
                                    <input id="small_photo_kullanici" type="file" name="files[]" multiple />
                                </form>
                            </div>
                            <button name="ekle" class="btn btn-success text-capitalize" type="button">ekle</button>
                        </div>
                    </div>

                    <% user_db.forEach(user_v=> { %>
                        <div class="collapse" id="k<%= user_v._id _%>">
                            <div class="card card-body">
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-name<%= user_v._id _%>">isim</label>
                                    <input type="text" class="form-control" id="Input-name<%= user_v._id _%>"
                                        aria-describedby="nameHelp" placeholder=" <%= user_v.name _%>">
                                    <small id="nameHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-surname<%= user_v._id _%>">soyad</label>
                                    <input type="text" class="form-control" id="Input-surname<%= user_v._id _%>"
                                        aria-describedby="surnameHelp<%= user_v._id _%>"
                                        placeholder=" <%= user_v.surname _%>">
                                    <small id="surnameHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-instagram<%= user_v._id _%>">
                                        instagram</label>
                                    <input type="text" class="form-control" id="Input-instagram<%= user_v._id _%>"
                                        aria-describedby="instagramHelp<%= user_v._id _%>"
                                        placeholder=" <%= user_v.instagram _%>">
                                    <small id="instagramHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-twitter<%= user_v._id _%>">
                                        twitter</label>
                                    <input type="text" class="form-control" id="Input-twitter<%= user_v._id _%>"
                                        aria-describedby="twitterHelp<%= user_v._id _%>"
                                        placeholder=" <%= user_v.twitter _%>">
                                    <small id="twitterHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-facebook<%= user_v._id _%>">
                                        facebook</label>
                                    <input type="text" class="form-control" id="Input-facebook<%= user_v._id _%>"
                                        aria-describedby="facebookHelp<%= user_v._id _%>"
                                        placeholder=" <%= user_v.facebook%>">
                                    <small id="facebookHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-linkedln<%= user_v._id _%>">
                                        linkedln</label>
                                    <input type="text" class="form-control" id="Input-linkedln<%= user_v._id _%>"
                                        aria-describedby="linkedlnHelp<%= user_v._id _%>"
                                        placeholder=" <%= user_v.linkedln%>">
                                    <small id="linkedlnHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-email<%= user_v._id _%>">e-posta</label>
                                    <input type="email" class="form-control" id="Input-email<%= user_v._id _%>"
                                        aria-describedby="emailHelp<%= user_v._id _%>"
                                        placeholder="<%= user_v.email _%>">
                                    <small id="emailHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">küçük harfle giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-password<%= user_v._id _%>">şifre</label>
                                    <input type="text" class="form-control" id="Input-password<%= user_v._id _%>"
                                        aria-describedby="passwordHelp<%= user_v._id _%>"
                                        placeholder="<%= user_v.password _%>">
                                    <small id="passwordHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize"> giriş
                                        yapınız</small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-tel_number<%= user_v._id _%>">telefon
                                        numarası</label>
                                    <input type="text" class="form-control" id="Input-tel_number<%= user_v._id _%>"
                                        aria-describedby="tel_numberHelp<%= user_v._id _%>"
                                        placeholder="<%= user_v.tel_number _%>">
                                    <small id="tel_numberHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize"> giriş yapınız </small>
                                </div>
                                <div class="form-group">
                                    <label class="text-capitalize" for="Input-danisman-metin<%= user_v._id _%>">danışman metin</label>
                                    <input type="text" class="form-control" id="Input-danisman-metin<%= user_v._id _%>"
                                        aria-describedby="danisman-metinHelp<%= user_v._id _%>"
                                        placeholder="<%= user_v.metin _%>">
                                    <small id="danisman-metinHelp<%= user_v._id _%>"
                                        class="form-text text-muted text-capitalize">metin girişini  yapınız </small>
                                </div>
                                <button name="kullanici-update" data-id="k<%= user_v._id _%>"
                                    class="btn btn-success text-capitalize" type="button">düzenle</button>
                                <button name="kullanici-sil" data-id="k<%= user_v._id _%>"
                                    class="btn btn-danger text-capitalize" type="button">sil</button>
                            </div>
                        </div>
                        <% }); %>

                </div>
            </div>

        </div>





    </div>


</div>