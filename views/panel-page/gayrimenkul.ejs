<div class="container-fluid">



    <!-- Content Row -->
    <div class="row">

        <div class="col-md-12 col-lg-8 col-xl-6 col-12">

            <!-- Basic Card Example -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary text-capitalize">ilan seri nu.:</h6>
                </div>
                <div class="card-body">
                    <%- include("../panel-layouts/mulk_search") %>
                        <form id="gayrimenkul" class="form-floating" onsubmit="event.preventDefault()">
                            <div class="input-group mb-3" id="seri-number">
                                <button class="input-group-text text-capitalize bg-success"
                                    id="seri-number-ekle">ekle</button>

                                <button name="mulk-search" data-bs-toggle="modal" data-bs-target="#mulk-search"
                                    class="input-group-text text-capitalize" id="seri-number-duzenle" disabled>bilgileri
                                    gör</button>
                                <button class="input-group-text text-capitalize bg-danger"
                                    id="seri-number-sil">sil</button>
                                <input name="seri-number-duzenle" type="text" class="form-control is-invalid"
                                    placeholder="seri numarası giriniz" aria-label="seri numarası giriniz"
                                    aria-describedby="seri-number-button">
                                <div class="col-12">
                                    <label class="mx-3 my-auto text-danger text-capitalize"
                                        for="seri-number-duzenle">düzenleme yapacaksanız boş
                                        bırakmayınız</label>
                                </div>
                            </div>


                            <label for="vitrin" class="form-label text-capitalize">vitrine ekle</label>
                            <div class="input-group mb-3 " id="vitrin">
                                <button name="vitrin" class="input-group-text text-capitalize"
                                    disabled>değiştir</button>
                                <select name="vitrin" class="form-control" aria-label="Default select">
                                    <option value="true">evet</option>
                                    <option selected value="false">hayır</option>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <label for="hiz-ilan" class="form-label text-capitalize">hizmet / ilan</label>
                                    <div class="input-group mb-3 " id="hiz-ilan">
                                        <button name="hiz-ilan" class="input-group-text text-capitalize"
                                            disabled>değiştir</button>
                                        <select name="hiz-ilan" class="form-control" aria-label="Default select">
                                            <option value="hizmet">hizmet</option>
                                            <option selected value="ilan">ilan</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label for="hiz-cesid" class="form-label text-capitalize">hizmet çeşidi</label>
                                    <div class="input-group mb-3 " id="hiz-cesid">
                                        <button name="hiz-cesid" class="input-group-text text-capitalize"
                                            disabled>değiştir</button>
                                        <select name="hiz-cesid" class="form-control" aria-label="Default select">
                                            <option value="sigorta">sigorta</option>
                                            <option value="kiralama">kiralama</option>
                                            <option value="tadilatvekomplebakim">tadilat ve komple bakım</option>
                                            <option selected value="temizlik">temizlik</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <label for="ilan-cesid" class="form-label text-capitalize">ilan çeşidi</label>
                            <div class="input-group mb-3 " id="ilan-cesid">
                                <button name="ilan-cesid" class="input-group-text text-capitalize"
                                    disabled>değiştir</button>
                                <select name="ilan-cesid" class="form-control" aria-label="Default select">
                                    <option value="kiralik">kiralık</option>
                                    <option value="proje">proje</option>
                                    <option selected value="satilik">satılık</option>
                                </select>
                            </div>

                            <label for="ilan-cinsi" class="form-label text-capitalize">ilan cinsi</label>
                            <div class="input-group mb-3 " id="ilan-cinsi">
                                <button name="ilan-cinsi" class="input-group-text text-capitalize"
                                    disabled>değiştir</button>
                                <select name="ilan-cinsi" class="form-control" aria-label="Default select">
                                    <option value="tarla">tarla</option>
                                    <option selected value="konut">konut</option>
                                </select>
                            </div>




                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize" id="metin-1" disabled>değiştir</button>
                                <input name="metin-1" type="text" class="form-control is-invalid"
                                    placeholder="metin giriniz" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="metin-1">boş
                                    bırakmayınız</label>
                            </div>

                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled
                                    id="metin-2">değiştir</button>
                                <input name="metin-2" type="text" class="form-control is-invalid"
                                    placeholder="metin giriniz" aria-label="metin giriniz" aria-describedby="metin-2">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="metin-2">boş
                                    bırakmayınız</label>
                            </div>

                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled id="price">değiştir</button>
                                <input name="price" type="text" class="form-control is-invalid"
                                    placeholder="fiyat giriniz" aria-label="fiyat giriniz" aria-describedby="price">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="price">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled id="adress">değiştir</button>
                                <input name="adress" type="text" class="form-control is-invalid"
                                    placeholder="adres giriniz" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="adress">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled
                                    id="province">değiştir</button>
                                <input name="province" type="text" class="form-control is-invalid"
                                    placeholder="il giriniz" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="province">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled
                                    id="country">değiştir</button>
                                <input name="country" type="text" class="form-control is-invalid"
                                    placeholder="ilçe giriniz" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="country">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled id="room">değiştir</button>
                                <input name="room" type="number" class="form-control is-invalid"
                                    placeholder="oda sayısı" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="room">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled
                                    id="bedroom">değiştir</button>
                                <input name="bedroom" type="number" class="form-control is-invalid"
                                    placeholder="yatakodası sayısı" aria-label="metin giriniz"
                                    aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="bedroom">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize disabled" id="bath">değiştir</button>
                                <input name="bath" type="number" class="form-control is-invalid"
                                    placeholder="banyo sayısı" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="bath">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " disabled
                                    id="area_net">değiştir</button>
                                <input name="area_net" type="number" class="form-control is-invalid"
                                    placeholder="net alan (m2)" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="area_net">boş
                                    bırakmayınız</label>
                            </div>
                            <div class="input-group mb-3">
                                <button class="input-group-text text-capitalize " id="area_brut">değiştir</button>
                                <input name="area_brut" type="number" class="form-control is-invalid"
                                    placeholder="bürüt alan (m2)" aria-label="metin giriniz" aria-describedby="metin-1">
                                <label class="mx-3 my-auto text-danger text-capitalize" for="area_brut">boş
                                    bırakmayınız</label>
                            </div>
                        </form>
                        <form id="gayrimenkul_photo" enctype="multipart/form-data">
                            <label for="small_photo" class="form-label text-capitalize">100x100 fotoğraf
                                yükleyiniz</label>
                            <input id="small_photo" type="file" name="files[]" multiple />
                        </form>
                </div>
            </div>

        </div>
        <div class="col-md-12 col-lg-8 col-xl-6 col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary text-capitalize">büyük fotoğraf eksik ilanlar</h6>
                </div>

                <% mulk_data.forEach(m_v=> { %>
                    <% if (m_v.image_large.length===0) { %>
                        <div class="card-body">
                            <label class="form-label text-capitalize">500x500 fotoğraf yükleyiniz. //</label>
                            <label class="form-label text-capitalize"><span class="pe-1 text-danger">
                                    <%= m_v.image_large.length _%>
                                </span> fotoğraf yüklü</label>
                            <form id="image_large" enctype="multipart/form-data">
                                <label class="form-label text-capitalize">seri nu.: <%= m_v.seri_number _%></label>
                                <input data-seri-nu="<%= m_v.seri_number _%>" type="file" name="files[]" multiple />
                            </form>
                            <!-- <button data-seri-nu="<%= m_v.seri_number _%>" class="mt-1 btn btn-danger"
                                type="button">fotoğrafları sil</button> -->
                        </div>
                        <% } %>
                            <% }); %>
            </div>

            <div class="card shadow mb-4 ">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary text-capitalize"> fotoğraflı ilanlar</h6>
                </div>
                <div class="scroll-behavior" >
                    <!-- style="max-height: 500px; overflow-y: scroll;" -->
                <% mulk_data.forEach(m_v=> { %>

                    <div class="card-body">
                        <label class="form-label text-capitalize"><%= m_v.seri_number %> seri numaralı //</label>
                        <label class="form-label text-capitalize">500x500 </label>
                        <label class="form-label text-capitalize"><span class="pe-1 text-danger">
                                <%= m_v.image_large.length _%>
                            </span> fotoğraf yüklü //</label>

                        <label class="form-label text-capitalize">100x100 </label>
                        <label class="form-label text-capitalize"><span class="pe-1 text-danger">
                                <%= m_v.image_small.length _%>
                            </span> fotoğraf yüklü//</label>
                    </div>
                    <hr>
                    <% }); %>



 


                    </div>




















            </div>

        </div>



    </div>


</div>